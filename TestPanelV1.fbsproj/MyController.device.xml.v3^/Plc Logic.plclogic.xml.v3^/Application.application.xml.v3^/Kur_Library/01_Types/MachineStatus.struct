__DECLARATION__
TYPE MachineStatus :
STRUCT
    // ---- COMMAND : HMI writes ----
    Power       : BOOL;     // is power OK
    Home        : BOOL;     // is home
    ManualMode      : BOOL;     // NOT Auto
	AutoMode        : BOOL;     // auto / manual selector

	ResetRequest	:BOOL;	// true if reset requert
	StopRequest		:BOOL; 
    // ---- STATUS : PLC writes ----
    SafetyOk    : BOOL;     // emergency + doors
    BusOk       : BOOL;     // fieldbus ready
    PowerOk     : BOOL;     // all drives powered
    HomeOk      : BOOL;     // all axes homed
    AxisOk      : BOOL;     // all axes no error
    Ready       : BOOL;     // all above + no alarm

    Running     : BOOL;     // machine running
END_STRUCT
END_TYPE
